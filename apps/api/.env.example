# Configuración General
PORT=3000
FRONTEND_URL=http://localhost:3000

# SUPABASE (PostgreSQL 15+ & Auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_service_role_key_here

# MOODLE LMS (LAMP Stack / Web Services)
MOODLE_URL=http://localhost/moodle
MOODLE_BASE_URL=http://localhost/moodle
MOODLE_WS_TOKEN=your_moodle_webservice_token_here
MOODLE_ROLE_STUDENT_ID=5
MOODLE_ROLE_TEACHER_ID=3
