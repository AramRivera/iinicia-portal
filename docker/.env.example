# ==============================================================================
# IINICIA PORTAL — VARIABLES DE ENTORNO PARA DOCKER COMPOSE
# Copiar este archivo a docker/.env antes de iniciar los contenedores
# ==============================================================================

# ----------------- PostgreSQL / Base de Datos -----------------
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar_password_segura_postgres_2026
DB_PORT=5432

# ----------------- Supabase Auth (GoTrue) -----------------
# Debe ser una cadena aleatoria de al menos 32 caracteres
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
AUTH_PORT=9999
AUTH_EXTERNAL_URL=http://localhost:9999
MAILER_AUTOCONFIRM=false

# ----------------- PostgREST (Data API) -----------------
REST_PORT=3001

# ----------------- Mailpit (SMTP & Web UI) -----------------
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# ----------------- Backend API (NestJS) -----------------
API_PORT=3000
FRONTEND_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:4000,http://127.0.0.1:4000
API_SUPABASE_URL=http://auth:9999
# Claves pública y privada (service role) generadas con el JWT_SECRET
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIn0.placeholder
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UifQ.placeholder

# ----------------- Moodle LMS -----------------
# Para Moodle en el host: http://host.docker.internal/moodle
# Para Moodle contenedorizado (--profile full-lms): http://moodle:8080/moodle
MOODLE_URL=http://host.docker.internal/moodle
MOODLE_BASE_URL=http://host.docker.internal/moodle
MOODLE_WS_TOKEN=token_generado_en_servicios_web_moodle
MOODLE_ROLE_STUDENT_ID=5
MOODLE_ROLE_TEACHER_ID=3

# Moodle contenedorizado opcional (--profile full-lms)
MOODLE_PORT=8080
MOODLE_DB_PASSWORD=cambiar_password_segura_mariadb
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=Admin.2026!
MOODLE_ADMIN_EMAIL=admin@iinicia.org

# ----------------- Frontend Portal (Next.js 16) -----------------
WEB_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_SUPABASE_URL=http://localhost:9999
NEXT_PUBLIC_MOODLE_URL=http://localhost/moodle
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
