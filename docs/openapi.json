  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "MeResponse": {
        "type": "object",
        "required": [
          "id",
          "email",
          "first_name",
          "last_name",
          "status",
          "roles",
          "permissions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "first_name": {
            "type": "string"
          },
          "last_name": {
            "type": "string"
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "avatar_url": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": [
              "pendiente",
              "activo",
              "suspendido",
              "inactivo",
              "baja"
            ]
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "estudiante"
            ]
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "campus.access"
            ]
          },
          "moodle_user_id": {
            "type": "integer",
            "nullable": true
          },
          "moodle_username": {
            "type": "string",
            "nullable": true
          },
          "moodle_sync_status": {
            "type": "string",
            "enum": [
              "no_vinculado",
              "pendiente",
              "sincronizado",
              "error",
              "suspendido_en_moodle"
            ]
          }
        }
      }
    }
  }
}